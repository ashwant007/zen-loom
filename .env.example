# These are the seven settings you paste into VERCEL (Project → Settings →
# Environment Variables). Never type the real values into the code files.
# The names on the left must match exactly.

# 1. Gemini (ears + brain)
GEMINI_API_KEY=your-gemini-key-here

# 2 & 3. Fish Audio (mouth)
FISH_AUDIO_API_KEY=your-fish-audio-key-here
FISH_AUDIO_VOICE_ID=your-chosen-voice-id

# 4 & 5. Composio + Google Drive (hands)
COMPOSIO_API_KEY=your-composio-key-here
DRIVE_FOLDER_ID=your-google-drive-folder-id

# 6 & 7. Supabase (memory)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional but recommended (a stronger Supabase key for the backend only):
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
